{
  "name": "cli-aspen",
  "version": "0.1.4",
  "description": "Create TypeScript backend projects (Express, Fastify, NestJS) with Prisma or Drizzle, ready to build, lint and test",
  "main": "dist/index.js",
  "bin": {
    "aspen": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "prepublishOnly": "npm run build",
    "aspen": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "cli",
    "scaffold",
    "backend",
    "generator",
    "typescript",
    "express",
    "fastify",
    "nestjs",
    "prisma",
    "drizzle"
  ],
  "author": "Mateus Fagundes",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^9.0.8",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "ejs": "^3.1.10",
    "execa": "^9.5.3",
    "fs-extra": "^11.3.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^9.2.23",
    "ora": "^8.2.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateuscastro5/aspen.git"
  },
  "homepage": "https://github.com/mateuscastro5/aspen#readme",
  "bugs": {
    "url": "https://github.com/mateuscastro5/aspen/issues"
  }
}
